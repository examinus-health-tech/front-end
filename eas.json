{
  "cli": {
    "version": ">= 7.7.0"
  },
  "build": {
    "preview": {
      "android": {
        "distribution": "internal",
        "buildType": "apk",
        "env": {
          "EXPO_USE_HERMES": "true"
        }
      },
      "ios": {
        "simulator": true
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "env": {
          "EXPO_USE_HERMES": "true"
        }
      }
    },
    "production": {
      "android": {
        "env": {
          "EXPO_USE_HERMES": "true"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}