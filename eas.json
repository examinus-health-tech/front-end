{
  "cli": {
    "version": ">= 7.7.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "android": {
        "distribution": "internal",
        "buildType": "apk",
        "env": {
          "EXPO_USE_HERMES": "true"
        }
      },
      "ios": {
        "simulator": true
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "env": {
          "EXPO_USE_HERMES": "true"
        }
      }
    },
    "production": {
      "channel": "production",
      "distribution": "store",
      "env": {
        "EXPO_USE_HERMES": "true"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {}
  }
}